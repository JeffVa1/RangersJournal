---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { RecapArc } from "../../lib/session-recaps";
import { recapArcs } from "../../lib/session-recaps";

export function getStaticPaths() {
  return recapArcs.map((arc) => ({
    params: { arc: arc.slug },
    props: { arc }
  }));
}

interface Props {
  arc: RecapArc;
}

const { arc } = Astro.props;
const otherArcs = recapArcs.filter((item) => item.slug !== arc.slug);
---

<BaseLayout title={`${arc.title} Recaps | Rangers Journal`} bodyClass="session-recaps-page">
  <main
    class="recaps-main recaps-detail-main"
    style={`--arc-color: ${arc.color}; --arc-background: url("${arc.background}");`}
    aria-labelledby="recap-arc-title"
    data-recaps-detail
  >
    <div class="recaps-backdrop" aria-hidden="true">
      <div class="recaps-backdrop-image recaps-arc-backdrop"></div>
      <div class="recaps-backdrop-vignette"></div>
    </div>

    <header class="recaps-detail-header">
      <div class="recaps-detail-actions">
        <nav class="recaps-top-actions" aria-label="Recap navigation">
          <a class="recaps-pill-link" href="/session-recaps">All arcs</a>
          {
            otherArcs.map((otherArc) => (
              <a class="recaps-pill-link" href={otherArc.href}>
                {otherArc.shortTitle}
              </a>
            ))
          }
        </nav>
        <a class="recaps-pill-link recaps-journal-link" href={arc.journalHref}>
          Open journal
        </a>
      </div>
      <p class="recaps-kicker">{arc.volumeLabel}</p>
      <h1 id="recap-arc-title">{arc.title}</h1>
      <p>{arc.description}</p>
    </header>

    <div class="recaps-detail-layout">
      <aside class="recaps-session-index" aria-label={`${arc.shortTitle} sessions`}>
        <p>Sessions</p>
        <ol>
          {
            arc.sessions.map((session, index) => (
              <li>
                <a
                  class={`recaps-session-link${index === 0 ? " is-active" : ""}`}
                  href={`#${session.anchor}`}
                  aria-current={index === 0 ? "location" : undefined}
                  data-recap-session-nav={session.anchor}
                  data-recap-session-trigger={session.anchor}
                >
                  <span>{session.title}</span>
                  <small>{session.date}</small>
                </a>
              </li>
            ))
          }
        </ol>
      </aside>

      <section class="recaps-reader" aria-label={`${arc.shortTitle} session recaps`}>
        <nav class="recaps-mobile-session-nav" aria-label="Jump to session">
          {
            arc.sessions.map((session, index) => (
              <a
                class={`recaps-mobile-session-link${index === 0 ? " is-active" : ""}`}
                href={`#${session.anchor}`}
                aria-current={index === 0 ? "location" : undefined}
                data-recap-session-nav={session.anchor}
                data-recap-session-trigger={session.anchor}
              >
                {session.number}
              </a>
            ))
          }
        </nav>

        {
          arc.sessions.map((session, index) => {
            const previousSession = arc.sessions[index - 1];
            const nextSession = arc.sessions[index + 1];

            return (
              <article
                class={`recap-session${index === 0 ? " is-active" : ""}`}
                id={session.anchor}
                data-recap-session={session.anchor}
                hidden={index > 0}
              >
                <header class="recap-session-header">
                  <p>{session.date}</p>
                  <h2>{session.title}</h2>
                  {session.summary && <p class="recap-session-summary">{session.summary}</p>}
                </header>

                <div class="recap-section-list">
                  {session.sections.map((section) => (
                    <section class="recap-story-section" aria-labelledby={section.id}>
                      <h3 id={section.id}>{section.title}</h3>
                      {section.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </section>
                  ))}
                </div>

                <footer class="recap-session-footer" aria-label={`${session.title} adjacent sessions`}>
                  {previousSession ? (
                    <a
                      href={`#${previousSession.anchor}`}
                      data-recap-session-trigger={previousSession.anchor}
                    >
                      <span>Previous</span>
                      {previousSession.title}
                    </a>
                  ) : (
                    <span></span>
                  )}
                  {nextSession && (
                    <a
                      href={`#${nextSession.anchor}`}
                      data-recap-session-trigger={nextSession.anchor}
                    >
                      <span>Next</span>
                      {nextSession.title}
                    </a>
                  )}
                </footer>
              </article>
            );
          })
        }
      </section>
    </div>
  </main>

  <script>
    const recapDetail = document.querySelector("[data-recaps-detail]");

    if (recapDetail) {
      const sessions = Array.from(recapDetail.querySelectorAll("[data-recap-session]"));
      const sessionNavLinks = Array.from(
        recapDetail.querySelectorAll("[data-recap-session-nav]")
      );
      const sessionTriggers = Array.from(
        recapDetail.querySelectorAll("[data-recap-session-trigger]")
      );
      const defaultSessionId = sessions[0]?.id ?? "";
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const hasSession = (sessionId) => sessions.some((session) => session.id === sessionId);

      const getHashSession = () => {
        const hash = window.location.hash.slice(1);
        return hasSession(hash) ? hash : "";
      };

      const scrollToSession = (sessionId, smooth = false) => {
        const activeSession = sessions.find((session) => session.id === sessionId);
        const activeNavLink = sessionNavLinks.find(
          (link) => link.getAttribute("data-recap-session-nav") === sessionId
        );

        activeSession?.scrollIntoView({
          block: "start",
          behavior: smooth && !prefersReducedMotion ? "smooth" : "auto"
        });
        activeNavLink?.scrollIntoView({
          block: "nearest",
          inline: "center",
          behavior: smooth && !prefersReducedMotion ? "smooth" : "auto"
        });
      };

      const setActiveSession = (sessionId, options = {}) => {
        const activeSessionId = hasSession(sessionId) ? sessionId : defaultSessionId;

        sessions.forEach((session) => {
          const isActive = session.id === activeSessionId;
          session.classList.toggle("is-active", isActive);
          session.hidden = !isActive;
        });

        sessionNavLinks.forEach((link) => {
          const isActive = link.getAttribute("data-recap-session-nav") === activeSessionId;
          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });

        if (options.updateHash && window.location.hash.slice(1) !== activeSessionId) {
          window.history.pushState(null, "", `#${activeSessionId}`);
        }

        if (options.scroll) {
          scrollToSession(activeSessionId, options.smooth);
        }
      };

      sessionTriggers.forEach((link) => {
        link.addEventListener("click", (event) => {
          const sessionId = link.getAttribute("data-recap-session-trigger");
          if (sessionId) {
            event.preventDefault();
            setActiveSession(sessionId, { updateHash: true, scroll: true, smooth: true });
          }
        });
      });

      const syncFromHash = () => {
        setActiveSession(getHashSession() || defaultSessionId, { scroll: Boolean(getHashSession()) });
      };

      window.addEventListener("hashchange", syncFromHash);
      window.addEventListener("popstate", syncFromHash);

      window.requestAnimationFrame(syncFromHash);
      window.setTimeout(syncFromHash, 120);
    }
  </script>
</BaseLayout>
