---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { RecapArc } from "../../lib/session-recaps";
import { recapArcs } from "../../lib/session-recaps";

export function getStaticPaths() {
  return recapArcs.map((arc) => ({
    params: { arc: arc.slug },
    props: { arc }
  }));
}

interface Props {
  arc: RecapArc;
}

const { arc } = Astro.props;
const otherArcs = recapArcs.filter((item) => item.slug !== arc.slug);
---

<BaseLayout title={`${arc.title} Recaps | Rangers Journal`} bodyClass="session-recaps-page">
  <main
    class="recaps-main recaps-detail-main"
    style={`--arc-color: ${arc.color}; --arc-background: url("${arc.background}");`}
    aria-labelledby="recap-arc-title"
    data-recaps-detail
  >
    <div class="recaps-backdrop" aria-hidden="true">
      <div class="recaps-backdrop-image recaps-arc-backdrop"></div>
      <div class="recaps-backdrop-vignette"></div>
    </div>

    <header class="recaps-detail-header">
      <nav class="recaps-top-actions" aria-label="Recap navigation">
        <a class="recaps-pill-link" href="/session-recaps">All arcs</a>
        {
          otherArcs.map((otherArc) => (
            <a class="recaps-pill-link" href={otherArc.href}>
              {otherArc.shortTitle}
            </a>
          ))
        }
      </nav>
      <p class="recaps-kicker">{arc.volumeLabel}</p>
      <h1 id="recap-arc-title">{arc.title}</h1>
      <p>{arc.description}</p>
    </header>

    <div class="recaps-detail-layout">
      <aside class="recaps-session-index" aria-label={`${arc.shortTitle} sessions`}>
        <p>Sessions</p>
        <ol>
          {
            arc.sessions.map((session) => (
              <li>
                <a
                  class="recaps-session-link"
                  href={`#${session.anchor}`}
                  data-recap-session-link={session.anchor}
                >
                  <span>{session.title}</span>
                  <small>{session.date}</small>
                </a>
              </li>
            ))
          }
        </ol>
      </aside>

      <section class="recaps-reader" aria-label={`${arc.shortTitle} session recaps`}>
        <nav class="recaps-mobile-session-nav" aria-label="Jump to session">
          {
            arc.sessions.map((session) => (
              <a
                class="recaps-mobile-session-link"
                href={`#${session.anchor}`}
                data-recap-session-link={session.anchor}
              >
                {session.number}
              </a>
            ))
          }
        </nav>

        {
          arc.sessions.map((session, index) => {
            const previousSession = arc.sessions[index - 1];
            const nextSession = arc.sessions[index + 1];

            return (
              <article class="recap-session" id={session.anchor} data-recap-session={session.anchor}>
                <header class="recap-session-header">
                  <p>{session.date}</p>
                  <h2>{session.title}</h2>
                  {session.summary && <p class="recap-session-summary">{session.summary}</p>}
                </header>

                <div class="recap-section-list">
                  {session.sections.map((section) => (
                    <section class="recap-story-section" aria-labelledby={section.id}>
                      <h3 id={section.id}>{section.title}</h3>
                      {section.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </section>
                  ))}
                </div>

                <footer class="recap-session-footer" aria-label={`${session.title} adjacent sessions`}>
                  {previousSession ? (
                    <a href={`#${previousSession.anchor}`}>
                      <span>Previous</span>
                      {previousSession.title}
                    </a>
                  ) : (
                    <span></span>
                  )}
                  {nextSession && (
                    <a href={`#${nextSession.anchor}`}>
                      <span>Next</span>
                      {nextSession.title}
                    </a>
                  )}
                </footer>
              </article>
            );
          })
        }
      </section>
    </div>
  </main>

  <script>
    const recapDetail = document.querySelector("[data-recaps-detail]");

    if (recapDetail) {
      const sessions = Array.from(recapDetail.querySelectorAll("[data-recap-session]"));
      const sessionLinks = Array.from(
        recapDetail.querySelectorAll("[data-recap-session-link]")
      );

      const setActiveSession = (sessionId) => {
        sessionLinks.forEach((link) => {
          const isActive = link.getAttribute("data-recap-session-link") === sessionId;
          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const getHashSession = () => {
        const hash = window.location.hash.slice(1);
        return sessions.some((session) => session.id === hash) ? hash : "";
      };

      const getVisibleSession = () => {
        const readingLine = window.innerHeight * 0.36;
        let activeSession = sessions[0]?.id ?? "";

        sessions.forEach((session) => {
          const rect = session.getBoundingClientRect();
          if (rect.top <= readingLine && rect.bottom > readingLine * 0.42) {
            activeSession = session.id;
          }
        });

        return activeSession;
      };

      const updateActiveSession = () => {
        setActiveSession(getVisibleSession() || getHashSession());
      };

      let activeFrame = 0;
      const queueActiveUpdate = () => {
        if (activeFrame) {
          return;
        }

        activeFrame = window.requestAnimationFrame(() => {
          activeFrame = 0;
          updateActiveSession();
        });
      };

      sessionLinks.forEach((link) => {
        link.addEventListener("click", () => {
          const sessionId = link.getAttribute("data-recap-session-link");
          if (sessionId) {
            setActiveSession(sessionId);
          }
        });
      });

      window.addEventListener("scroll", queueActiveUpdate, { passive: true });
      window.addEventListener("resize", queueActiveUpdate);
      window.addEventListener("hashchange", queueActiveUpdate);

      window.requestAnimationFrame(updateActiveSession);
      window.setTimeout(updateActiveSession, 120);
    }
  </script>
</BaseLayout>
